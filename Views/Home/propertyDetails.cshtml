@model Property
@inject AppDbContext db
@{
    ViewData["Title"] = "DoradoHome";
}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url(@Model.Img);" data-aos="fade" data-stellar-background-ratio="0.5">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-md-10">
                <span class="d-inline-block text-white px-3 mb-3 property-offer-type rounded">Property Details of</span>
                <h1 class="mb-2">@Model.Name</h1>
                <p class="mb-5"><strong class="h2 text-success font-weight-bold">$@Model.Price.ToString("##,0")</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="site-section site-section-sm">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div>
                    @{
                        var images = Model.PropertyImages.Select(x => x.ImageUrl).ToArray();
                    }
                    <div class="slide-one-item home-slider owl-carousel">
                        @foreach (var image in images)
                        {
                            <div><img src="@image" alt="Image" class="img-fluid"></div>
                        }
                    </div>
                </div>
                <div class="bg-white property-body border-bottom border-left border-right">
                    <div class="row mb-5">
                        <div class="col-md-6">
                            <strong class="text-success h1 mb-3">$@Model.Price.ToString("##,0")</strong>
                        </div>
                        <div class="col-md-6">
                            <ul class="property-specs-wrap mb-3 mb-lg-0  float-lg-right">
                                <li>
                                    <span class="property-specs">Beds</span>
                                    <span class="property-specs-number">@Model.BedRooms <sup>+</sup></span>

                                </li>
                                <li>
                                    <span class="property-specs">Baths</span>
                                    <span class="property-specs-number">@Model.BathRooms</span>

                                </li>
                                <li>
                                    <span class="property-specs">SQ FT</span>
                                    <span class="property-specs-number">@Model.Area.ToString("##,0")</span>

                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="row mb-5">
                        <div class="col-md-6 col-lg-4 text-center border-bottom border-top py-3">
                            <span class="d-inline-block text-black mb-0 caption-text">Property Type</span>
                            <strong class="d-block">@Model.PropertyType</strong>
                        </div>
                        <div class="col-md-6 col-lg-4 text-center border-bottom border-top py-3">
                            <span class="d-inline-block text-black mb-0 caption-text">Year Built</span>
                            <strong class="d-block">@Model.YearBuilt</strong>
                        </div>
                        <div class="col-md-6 col-lg-4 text-center border-bottom border-top py-3">
                            <span class="d-inline-block text-black mb-0 caption-text">Price/Sqft</span>
                            @{var pricePerSquare = (int)Model.PricePerSquare;}
                            <strong class="d-block">$@pricePerSquare</strong>
                        </div>
                    </div>
                    <h2 class="h4 text-black">More Info</h2>
                    <p>@Model.Description</p>

                    <div class="row no-gutters mt-5">
                        <div class="col-12">
                            <h2 class="h4 text-black mb-3">Gallery</h2>
                        </div>
                        @foreach (var image in images)
                        {
                            <div class="col-sm-6 col-md-4 col-lg-3">
                                <img src="@image" alt="Image" class="img-fluid">
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">

                <div class="bg-white widget border rounded">

                    <h3 class="h4 text-black widget-title mb-3">Interested in this property?</h3>
                    <p class="text-muted mb-4" style="font-size:.92rem;">Schedule a viewing and our team will walk you through buying or renting this property.</p>

                    @if (Model.OfferType == OfferType.ForSale)
                    {
                        <a asp-action="ScheduleToBuy" asp-controller="Home" asp-route-id="@Model.Id" class="btn btn-primary btn-block py-3 mb-3">
                            <span class="icon-usd mr-2"></span>Schedule a Viewing to Buy
                        </a>
                    }
                    else
                    {
                        <a asp-action="ScheduleToRent" asp-controller="Home" asp-route-id="@Model.Id" class="btn btn-success text-white btn-block py-3">
                            <span class="icon-key mr-2"></span>Schedule a Viewing to Rent
                        </a>
                    }
                    <hr class="my-4">

                    <div class="d-flex align-items-center">
                        <img src="@Model.Employee?.Img" class="rounded-circle mr-3" style="width:48px;height:48px;object-fit:cover;">
                        <div>
                            <div class="text-black font-weight-bold" style="font-size:.95rem;">@Model.Employee?.FullName</div>
                            <div class="text-muted" style="font-size:.82rem;">Listing Agent</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@{
    var properties = db.Properties.Where(x => x.Status == PropertyStatus.Active).Take(3).ToList();
}
<div class="site-section site-section-sm bg-light">
    <div class="container">

        <div class="row">
            <div class="col-12">
                <div class="site-section-title mb-5">
                    <h2>Related Properties</h2>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            @foreach (var property in properties)
            {
                if(property.Id != Model.Id)
                {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="property-entry h-100">
                        <a asp-action="propertyDetails" asp-controller="Home" asp-route-id="@property.Id" class="property-thumbnail">
                            <div class="offer-type-wrap">
                                @if (property.OfferType == OfferType.ForSale)
                                {
                                    <span class="offer-type bg-danger">Sale</span>
                                }
                                else
                                {
                                    <span class="offer-type bg-success">Rent</span>
                                }
                            </div>
                        <img src="@property.Img" alt="Image" class="img-fluid">
                    </a>
                    <div class="p-4 property-body">
                        <a asp-action="SaveProperty" asp-controller="Home" asp-route-id="@property.Id" class="property-favorite"><span class="icon-heart-o"></span></a>
                        <h2 class="property-title"><a href="property-details.html">@property.Name</a></h2>
                        <span class="property-location d-block mb-3"><span class="property-icon icon-room"></span> @property.Address @property.City, @property.State @property.ZipCode</span>
                        <strong class="property-price text-primary mb-3 d-block text-success">$@property.Price.ToString("##,0")</strong>
                        <ul class="property-specs-wrap mb-3 mb-lg-0">
                            <li>
                                <span class="property-specs">Beds</span>
                                <span class="property-specs-number">@property.BedRooms <sup>+</sup></span>

                            </li>
                            <li>
                                <span class="property-specs">Baths</span>
                                <span class="property-specs-number">@property.BathRooms</span>

                            </li>
                            <li>
                                <span class="property-specs">SQ FT</span>
                                <span class="property-specs-number">@property.Area.ToString("##,0")</span>

                            </li>
                        </ul>

                    </div>
                    </div>
                </div>
                }
            }
        </div>
    </div>
</div>