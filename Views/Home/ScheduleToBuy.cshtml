@model ScheduleVM
@{
    ViewData["Title"] = "Schedule To Buy";
}
<div class="site-blocks-cover inner-page-cover overlay" style="background-image: url(@Model.Property?.Img);" data-aos="fade">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center">
            <div class="col-md-10">
                <span class="d-inline-block text-white px-3 mb-3 property-offer-type rounded">Book an Appointment</span>
                <h1 class="mb-2">@Model.Property?.Name</h1>
            </div>
        </div>
    </div>
</div>
<div asp-validation-summary="All"></div>
<div class="site-section site-section-sm">
    <div class="container">

        <div class="row">
            <div class="col-lg-8 mb-5 mb-lg-0">
                <form asp-action="ScheduleToBuy" asp-controller="Home" method="post" class="appointment-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PropertyId">
                    <input type="hidden" asp-for="EmployeeId">

                    <div class="mb-5">
                        <div class="section-title">Your Information</div>
                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label asp-for="FullName">Full Name</label>
                                <input asp-for="FullName" type="text" class="form-control" placeholder="Amelia Rhodes">
                            </div>
                            <div class="col-md-6 form-group">
                                <label asp-for="EmailAddress">Email Address</label>
                                <input asp-for="EmailAddress" type="email" class="form-control" placeholder="you@example.com">
                            </div>
                        </div>
                        <div class="form-group mb-0">
                            <label asp-for="Phone">Phone Number</label>
                            <input asp-for="Phone" type="text" class="form-control" placeholder="+1 (213) 555-0100" style="max-width:320px;">
                        </div>
                    </div>

                    <div class="mb-5">
                        <div class="section-title">Appointment Type</div>
                        <div class="row mb-4">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="option-card mb-0">
                                    <input type="radio" name="AppointmentType" value="InPersonTour" checked>
                                    <span class="option-icon icon-home2"></span>
                                    <span class="option-label">In-Person Tour</span>
                                </label>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="option-card mb-0">
                                    <input type="radio" name="AppointmentType" value="VirtualTour">
                                    <span class="option-icon icon-video-camera"></span>
                                    <span class="option-label">Virtual Tour</span>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="option-card mb-0">
                                    <input type="radio" name="AppointmentType" value="PhoneCall">
                                    <span class="option-icon icon-phone2"></span>
                                    <span class="option-label">Phone Call</span>
                                </label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label asp-for="Date">Preferred Date</label>
                                <input asp-for="Date" type="date" class="form-control">
                            </div>
                            <div class="col-md-6 form-group mb-0">
                                <label asp-for="Time" class="d-block">Preferred Time</label>
                                <input asp-for="Time" type="time" class="form-control">
                            </div>
                        </div>
                    </div>

                    <div class="mb-5">
                        <div class="section-title">Additional Message</div>
                        <div class="form-group mb-0">
                            <textarea asp-for="AdditionalMessage" class="form-control" rows="4" placeholder="Anything the agent should know before your appointment..."></textarea>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary py-3 px-5">Request Appointment</button>
                    <p class="text-muted mt-3 mb-0" style="font-size:.82rem;">Can check the appointment status in your Dashboard.</p>
                </form>
            </div>

            <div class="col-lg-4">
                <div class="bg-white widget border rounded appointment-summary">
                    <img src="@Model.Property?.Img" class="img-fluid rounded mb-3" alt="Property Image">
                    <h3 class="h5 text-black mb-1">@Model.Property?.Name</h3>
                    <p class="text-muted mb-3" style="font-size:.88rem;"><span class="icon-room mr-1"></span>@Model.Property?.City, @Model.Property?.State &middot; @Model.Property?.PropertyType</p>
                    <ul class="appointment-specs mb-3">
                        <li><span class="icon-bed"></span> @Model.Property?.BedRooms+ Beds</li>
                        <li><span class="icon-bath"></span> @Model.Property?.BathRooms Baths</li>
                        <li><span class="icon-expand"></span> @Model.Property?.Area.ToString("##,0") sqft</li>
                    </ul>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size:.85rem;">Listing Price</span>
                        <strong class="h4 text-success mb-0">$@Model.Property?.Price.ToString("##,0")</strong>
                    </div>
                </div>

                <div class="bg-white widget border rounded mt-4">
                    <div class="d-flex align-items-center">
                        <img src="@Model.Employee?.Img" class="rounded-circle mr-3" style="width:48px;height:48px;object-fit:cover;">
                        <div>
                            <div class="text-black font-weight-bold" style="font-size:.95rem;">@Model.Employee?.FullName</div>
                            <div class="text-muted" style="font-size:.82rem;">Listing Agent</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>