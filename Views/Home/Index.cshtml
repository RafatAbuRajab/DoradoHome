@model PaginationVM
@inject AppDbContext db
@inject UserManager<AppUser> userManager
@{
    ViewData["Title"] = "DoradoHome";
}
<div class="slide-one-item home-slider owl-carousel">

    @{
        var property1 = Model.Properties.Where(x => x.OfferType == OfferType.ForSale && x.IsSold == false).FirstOrDefault();
        var property2 = Model.Properties.Where(x => x.OfferType == OfferType.ForRent && x.IsRented == false).FirstOrDefault();
    }

    <div class="site-blocks-cover overlay" style="background-image: url(/assets/images/hero_bg_1.jpg);" data-aos="fade" data-stellar-background-ratio="0.5">
        <div class="container">
            <div class="row align-items-center justify-content-center text-center">
                <div class="col-md-10">
                    <h1 class="mb-2">Welcome To DoradoHome<span class="text-danger">.</span></h1>
                    <p class="mb-5"><strong class="h2 text-success font-weight-bold">Explore Our Properties</strong></p>
                </div>
            </div>
        </div>
    </div>

    @if(property1 != null)
    {
    <div class="site-blocks-cover overlay" style="background-image: url(@property1.Img);" data-aos="fade" data-stellar-background-ratio="0.5">
        <div class="container">
            <div class="row align-items-center justify-content-center text-center">
                <div class="col-md-10">
                    <span class="d-inline-block bg-danger text-white px-3 mb-3 property-offer-type rounded">For Sale</span>
                    <h1 class="mb-2">@property1.Name</h1>
                    <p class="mb-5"><strong class="h2 text-success font-weight-bold">$@property1.Price.ToString("##,0")</strong></p>
                    <p><a asp-action="propertyDetails" asp-controller="Home" asp-route-id="@property1.Id" class="btn btn-white btn-outline-white py-3 px-5 rounded-0 btn-2">See Details</a></p>
                </div>
            </div>
        </div>
    </div>
    }

    @if(property2 != null)
    {
    <div class="site-blocks-cover overlay" style="background-image: url(@property2.Img);" data-aos="fade" data-stellar-background-ratio="0.5">
        <div class="container">
            <div class="row align-items-center justify-content-center text-center">
                <div class="col-md-10">
                    <span class="d-inline-block bg-success text-white px-3 mb-3 property-offer-type rounded">For Rent</span>
                    <h1 class="mb-2">@property2.Name</h1>
                    <p class="mb-5"><strong class="h2 text-success font-weight-bold">$@property2.Price.ToString("##,0")</strong></p>
                    <p><a asp-action="propertyDetails" asp-controller="Home" asp-route-id="@property2.Id" class="btn btn-white btn-outline-white py-3 px-5 rounded-0 btn-2">See Details</a></p>
                </div>
            </div>
        </div>
    </div>
    }
</div>

<div class="site-section site-section-sm bg-light">
    <div class="container">

        <div class="row mb-5">
            @foreach (var item in Model.Properties.Where(x => x.Status == PropertyStatus.Active))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="property-entry h-100">
                        <a asp-action="propertyDetails" asp-controller="Home" asp-route-id="@item.Id" class="property-thumbnail">
                            <div class="offer-type-wrap">
                                @if (item.OfferType == OfferType.ForSale)
                                {
                                    <span class="offer-type bg-danger">Sale</span>
                                }
                                else
                                {
                                    <span class="offer-type bg-success">Rent</span>
                                }
                            </div>
                        <img src="@item.Img" alt="Image" class="img-fluid">
                    </a>
                    <div class="p-4 property-body">
                        <a asp-action="SaveProperty" asp-controller="Home" asp-route-id="@item.Id" class="property-favorite"><span class="icon-heart-o"></span></a>
                        <h2 class="property-title"><a asp-action="propertyDetails" asp-controller="Home" asp-route-id="@item.Id">@item.Name</a></h2>
                        <span class="property-location d-block mb-3"><span class="property-icon icon-room"></span> @item.Address @item.City, @item.State @item.ZipCode</span>
                        <strong class="property-price text-primary mb-3 d-block text-success">$@item.Price.ToString("##,0")</strong>
                        <ul class="property-specs-wrap mb-3 mb-lg-0">
                            <li>
                                <span class="property-specs">Beds</span>
                                <span class="property-specs-number">@item.BedRooms <sup>+</sup></span>

                            </li>
                            <li>
                                <span class="property-specs">Baths</span>
                                <span class="property-specs-number">@item.BathRooms</span>

                            </li>
                            <li>
                                <span class="property-specs">SQ FT</span>
                                <span class="property-specs-number">@item.Area.ToString("##,0")</span>

                            </li>
                        </ul>

                    </div>
                </div>
            </div>
            }
        </div>
        <div class="row">
            <div class="col-md-12 text-center">
                <div class="site-pagination">
                    @if(Model.Properties.Where(x => x.Status == PropertyStatus.Active).Count() > 0)
                    {
                        @if (Model.CurrentPage > 1)
                        {
                            <a asp-action="Index" asp-controller="Home"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                Prev
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Index" asp-controller="Home"
                               asp-route-page="@i"
                               class="@(i == Model.CurrentPage ? "active" : "")">
                                @i
                            </a>
                        }

                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a asp-action="Index" asp-controller="Home"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Next
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<div class="site-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">
                <div class="site-section-title">
                    <h2>Why Choose Us?</h2>
                </div>
                <p>Everything you need to buy, rent, or sell — backed by agents who actually pick up the phone.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 col-lg-4">
                <a class="service text-center">
                    <span class="icon flaticon-house"></span>
                    <h2 class="service-heading">Research Subburbs</h2>
                    <p>Compare neighborhoods by schools, commute times, and price trends before you fall in love with a listing.</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a class="service text-center">
                    <span class="icon flaticon-sold"></span>
                    <h2 class="service-heading">Sold Houses</h2>
                    <p>Browse recently sold homes nearby to understand what similar properties are actually going for.</p>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a class="service text-center">
                    <span class="icon flaticon-camera"></span>
                    <h2 class="service-heading">Security Priority</h2>
                    <p>Every listing and agent on Homeland is verified, so you can browse and message with confidence.</p>
                </a>
            </div>
        </div>
    </div>
</div>

@{
    var UsersInRole = await userManager.GetUsersInRoleAsync("Agent");
    var userId = UsersInRole.Select(x => x.Id).ToList();
    var Agents = db.Employees
    .Where(x => userId.Contains(x.UserId))
    .ToList();
}
<div class="site-section">
    <div class="container">
        <div class="row mb-5 justify-content-center">
            <div class="col-md-7">
                <div class="site-section-title text-center">
                    <h2>Our Agents</h2>
                    <p>Have a question or want to talk through your options? Reach out directly to any of our agents below.</p>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var Agent in Agents)
            {
                    <div class="col-md-6 col-lg-4 mb-5 mb-lg-5">
                        <div class="team-member">

                            <img src="@Agent.Img" alt="Image" class="img-fluid rounded mb-4">

                            <div class="text">

                                <h2 class="mb-2 font-weight-light text-black h4">@Agent.FullName</h2>
                                <span class="d-block mb-3 text-white-opacity-05">Real Estate Agent</span>
                                <p>@Agent.Email</p>
                                <p>@Agent.Phone</p>
                                <p>
                                    <a href="mailto:@Agent.Email" class="text-black p-2"><span class="icon-mail_outline"></span></a>
                                    <a href="tel:@Agent.Phone" class="text-black p-2"><span class="icon-phone"></span></a>
                                    <a href="https://wa.me/@Agent.Phone" class="text-black p-2"><span class="icon-whatsapp"></span></a>
                                </p>
                            </div>

                        </div>
                    </div>
            }
        </div>
    </div>
</div>