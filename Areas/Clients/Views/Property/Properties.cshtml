@model List<Property>
@{
    ViewData["Title"] = "My Properties";
}
<div class="page-head">
    <div>
        <h1>My Properties</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Index" asp-controller="Home" asp-area="">Home</a><span class="sep">/</span><a asp-action="ClientDashboard" asp-controller="Dashboard">Dashboard</a><span class="sep">/</span><span class="current">My Properties</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="hl-card">
            <div class="hl-card-head">
                <h2>Properties You Own</h2>
            </div>
            <div class="table-responsive">
                <table class="table hl-table">
                    <thead><tr><th>Property</th><th>Purchase Date</th><th>Purchase Price</th><th>Agent</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            foreach(var sales in item.Sales)
                            {
                            <tr>
                                <td><div class="d-flex align-items-center"><img src="@item.Img" class="row-thumb mr-3"><div><div class="row-title">@item.Name</div><div class="row-sub">@item.City, @item.City</div></div></div></td>
                                <td>@sales.SaleDate</td>
                                <td>$@item.Price.ToString("##,0")</td>
                                <td><div class="d-flex align-items-center"><img src="@item.Employee?.Img" class="avatar-sm mr-2">@item.Employee?.FullName</div></td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>