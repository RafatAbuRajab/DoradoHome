@model List<SavedProperty>
@{
    ViewData["Title"] = "Saved Properties";
}
<div class="page-head">
    <div>
        <h1>Saved Properties</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Index" asp-controller="Home" asp-area="">Home</a><span class="sep">/</span><a asp-action="ClientDashboard" asp-controller="Dashboard">Dashboard</a><span class="sep">/</span><span class="current">Saved Properties</span>
        </div>
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-sm-6 col-lg-4 mb-4">
            <div class="hl-card h-100 mb-0">
                <img src="@item.Property?.Img" style="width:100%;height:160px;object-fit:cover;border-radius:10px 10px 0 0;">
                <div class="hl-card-body">
                    <div class="row-title">@item.Property?.Name</div>
                    <div class="row-sub mb-3">$@item.Property?.Price.ToString("##,0") &middot; @item.Property?.City, @item.Property?.State</div>
                    <div class="d-flex" style="gap:.5rem;">
                        <a asp-action="propertyDetails" asp-controller="Home" asp-area="" asp-route-id="@item.Property?.Id" class="btn-hl-outline btn btn-sm flex-fill">View</a>
                        <a asp-action="Remove" asp-controller="SavedProperty" asp-route-id="@item.PropertyId" class="btn-hl-outline btn btn-sm flex-fill"><span class="icon-close2"></span> Remove</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>