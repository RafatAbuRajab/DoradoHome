@model List<Appointment>
@{
    ViewData["Title"] = "My Appointments";
}
<div class="page-head">
    <div>
        <h1>My Appointments</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Index" asp-controller="Home" asp-area="">Home</a><span class="sep">/</span><a asp-action="ClientDashboard" asp-controller="Dashboard">Dashboard</a><span class="sep">/</span><span class="current">My Appointments</span>
        </div>
    </div>
    <a asp-action="Index" asp-controller="Home" asp-area="" class="btn btn-hl-primary btn-sm"><span class="icon-plus mr-1"></span>Book a Viewing</a>
</div>

<div class="row mb-4">
    <div class="col-sm-6 col-xl-3 mb-3 mb-xl-0">
        <div class="stat-card h-100">
            <span class="stat-icon bg-1"><span class="icon-calendar"></span></span>
            <div><div class="stat-value">@Model.Select(x => x.Id).Count()</div>
            <div class="stat-label">Total Appointments</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 mb-3 mb-xl-0">
        <div class="stat-card h-100">
            <span class="stat-icon bg-3"><span class="icon-check-circle"></span></span>
            <div><div class="stat-value">@Model.Where(x => x.Status == AppointmentStatus.Confirmed).Count()</div>
            <div class="stat-label">Confirmed</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <span class="stat-icon bg-4"><span class="icon-hourglass-half"></span></span>
            <div><div class="stat-value">@Model.Where(x => x.Status == AppointmentStatus.Pending).Count()</div>
            <div class="stat-label">Pending</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card h-100">
            <span class="stat-icon bg-2"><span class="icon-close2"></span></span>
            <div><div class="stat-value">@Model.Where(x => x.Status == AppointmentStatus.Rejected).Count()</div>
            <div class="stat-label">Rejected</div></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="hl-card">
            <div class="hl-card-head">
                <h2>Offers From Your Agent</h2>
                <span class="row-sub">Accepting an offer moves it to a closed sale or an active rental</span>
            </div>
            <div class="table-responsive">
                <table class="table hl-table">
                    <thead><tr><th>Property</th><th>Offer Type</th><th>Terms</th><th>Agent</th><th>Status</th><th style="width:160px;">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Where(x => x.Status == AppointmentStatus.PendingConfirmation))
                        {
                            foreach(var offer in item.Offers)
                            {
                            <tr>
                                <td><div class="d-flex align-items-center"><img src="@item.Property?.Img" class="row-thumb mr-3"><div class="row-title">@item.Property?.Name</div></div></td>
                                <td>@item.Property?.OfferType</td>
                                    @if (item.Property?.OfferType == OfferType.ForSale)
                                    {
                                        <td>$@offer.SalePrice?.ToString("##,0") &middot; Closing @offer.ClosingDate</td>
                                    }
                                    else
                                    {
                                        <td>$@offer.MonthlyRent?.ToString("##,0") &middot; Lease Term @offer.LeaseTerm Month</td>
                                    }
                                    <td><div class="d-flex align-items-center"><img src="@item.Employee?.Img" class="avatar-sm mr-2">@item.Employee?.FullName</div></td>
                                <td><span class="status-pill pending">Awaiting Your Response</span></td>
                                <td>
                                    <div class="row-actions">
                                        <a asp-action="OfferAccepted" asp-controller="Appointment" asp-route-id="@offer.Id" title="Accept Offer" style="color:var(--hl-success);"><span class="icon-check"></span></a>
                                        <a asp-action="OfferRejected" asp-controller="Appointment" asp-route-id="@offer.Id" class="danger" title="Decline Offer"><span class="icon-close"></span></a>
                                    </div>
                                </td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="hl-card">
            <div class="hl-card-head">
                <h2>Appointment History</h2>
                <span class="row-sub">Status updates automatically once your agent responds</span>
            </div>
            <div class="table-responsive">
                <table class="table hl-table">
                    <thead><tr><th>Property</th><th>Date &amp; Time</th><th>Type</th><th>Agent</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Where(x => x.Status != AppointmentStatus.PendingConfirmation))
                        {
                            <tr>
                                <td><div class="d-flex align-items-center"><img src="@item.Property?.Img" class="row-thumb mr-3"><div class="row-title">@item.Property?.Name</div></div></td>
                                <td>@item.Date<div class="row-sub">@item.Time</div></td>
                                <td>@item.appointmentType</td>
                                <td><div class="d-flex align-items-center"><img src="@item.Employee?.Img" class="avatar-sm mr-2">@item.Employee?.FullName</div></td>
                                <td>
                                    <span class="status-pill @(item.Status == AppointmentStatus.Confirmed ? "confirmed" :
                                                               item.Status == AppointmentStatus.Pending ? "pending" :
                                                               item.Status == AppointmentStatus.Rejected ? "rejected" : "closed")">
                                                             @(item.Status == AppointmentStatus.Confirmed ? "Confirmed" :
                                                               item.Status == AppointmentStatus.Pending ? "Pending" :
                                                               item.Status == AppointmentStatus.Rejected ? "Rejected" : "Closed")
                                    </span>
                            </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>