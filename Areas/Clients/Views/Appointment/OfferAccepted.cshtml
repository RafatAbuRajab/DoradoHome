@model Offer
@{
    ViewData["Title"] = "Offer Accepted";
}
<div class="row justify-content-center text-center mb-4">
    <div class="col-md-8">
        <span class="stat-icon bg-3 mb-3" style="width:84px;height:84px;font-size:2.4rem;border-radius:50%;"><span class="icon-check"></span></span>
        <h1 class="mb-2">Offer Accepted!</h1>
        <p class="row-sub mb-1">You've accepted the offer on <strong class="text-black">@Model.Property?.Name</strong> from @Model.Employee?.FullName.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="hl-card mb-4">
            <div class="hl-card-head"><h2>What happens next</h2></div>
            <div class="hl-card-body">
                <div class="d-flex py-3" style="border-bottom:1px solid var(--hl-border);">
                    <span class="stat-icon bg-1 mr-3" style="width:36px;height:36px;font-size:.9rem;">1</span>
                    <div>
                        <strong class="d-block text-black">Sale Recorded</strong>
                        <span class="row-sub">This property now shows as a closed sale on your agent's dashboard.</span>
                    </div>
                </div>
                <div class="d-flex py-3" style="border-bottom:1px solid var(--hl-border);">
                    <span class="stat-icon bg-1 mr-3" style="width:36px;height:36px;font-size:.9rem;">2</span>
                    <div>
                        <strong class="d-block text-black">Contract &amp; Paperwork</strong>
                        <span class="row-sub">@Model.Employee?.FullName will send over the purchase contract for signing.</span>
                    </div>
                </div>
                <div class="d-flex py-3">
                    <span class="stat-icon bg-1 mr-3" style="width:36px;height:36px;font-size:.9rem;">3</span>
                    <div>
                        <strong class="d-block text-black">Closing</strong>
                        <span class="row-sub">You'll be contacted to finalize financing and schedule your closing date.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center">
            <a asp-action="MyAppointments" asp-controller="Appointment" class="btn btn-hl-outline mr-2">Back to My Appointments</a>
            <a asp-action="ClientDashboard" asp-controller="Dashboard" class="btn btn-hl-primary">Go to Dashboard</a>
        </div>
    </div>
</div>