@model IEnumerable<AppRole>
@using DoradoHome.Data
@inject AppDbContext DbContext
@inject RoleManager<AppRole> roleManager
@inject UserManager<AppUser> userManager
@{
    ViewData["Title"] = "Roles";
    var roles = DbContext.UserRoles.Count();
}
<div class="page-head">
    <div>
        <h1>Roles</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Dashboard" asp-controller="Dashboard">Home</a><span class="sep">/</span><span class="current">Roles</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-6 col-xl-3 mb-4">
        <div class="stat-card h-100">
            <span class="stat-icon bg-1"><span class="icon-shield"></span></span>
            <div>
                <div class="stat-value">@ViewBag.TotalRoles</div>
                <div class="stat-label">Total Roles</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 mb-4">
        <div class="stat-card h-100">
            <span class="stat-icon bg-3"><span class="icon-users"></span></span>
            <div>
                <div class="stat-value">@roles</div>
                <div class="stat-label">Users Assigned</div>
            </div>
        </div>
    </div>
</div>

<div class="hl-card">
    <div class="hl-card-head flex-wrap">
        <h2>All Roles</h2>
        <a asp-action="CreateRole" asp-controller="Roles" asp-area="Admin" class="btn btn-hl-primary btn-sm"><span class="icon-plus mr-1"></span>Create Role</a>
    </div>
    <div class="table-responsive">
        <table class="table hl-table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Description</th>
                    <th>Users</th>
                    <th style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="stat-icon bg-2 mr-3" style="width:38px;height:20px;font-size:1rem;"><span class="icon-shield"></span></span>
                                <div>
                                    <div class="row-title">@item.Name</div>
                                </div>
                            </div>
                        </td>
                        <td class="row-sub">@item.Description</td>
                        @{
                            var role = await roleManager.GetRoleNameAsync(new AppRole{Name = item.Name});
                            var userInRole = await userManager.GetUsersInRoleAsync(role);
                        }
                        <td style="padding-left: 32px;">@userInRole.Count</td>
                        <td>
                            <div class="row-actions">
                                <a asp-action="AssignRole" asp-controller="Roles" asp-route-Assignedid="@item.Id" title="Assign"><span class="icon-add"></span></a>
                                <a asp-action="EditRole" asp-controller="Roles" asp-route-roleId="@item.Id" title="Edit"><span class="icon-pencil"></span></a>
                                <a asp-action="DeleteRole" asp-controller="Roles" asp-route-id="@item.Id"><span class="icon-trash-o"></span></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>