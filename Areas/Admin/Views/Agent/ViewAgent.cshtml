@inject RoleManager<AppRole> roleManager
@inject UserManager<AppUser> userManager
@model Employee
@{
    
    ViewData["Title"] = "View Agent";

    var user = await userManager.FindByEmailAsync(Model.Email);
    var role = await userManager.GetRolesAsync(user);
}
<div class="page-head">
    <div>
        <h1>View Agent</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Dashboard" asp-controller="Dashboard">Home</a><span class="sep">/</span><a asp-action="Agent" asp-controller="Agent">Agents</a><span class="sep">/</span><span class="current">View Agent</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="hl-card">
            <div class="hl-card-body text-center">
                <img src="@Model.Img" class="avatar-md mb-3" style="width:96px;height:96px;">
                <h4 class="font-weight-bold mb-0">@(Model.FirstName + " " + Model.LastName)</h4>
                <div class="row-sub mb-3">@role.First()</div>
                <span class="status-pill @(Model.IsActive ? "active" : "inactive") mb-3 d-inline-block">@(Model.IsActive ? "Active" : "Inactive")</span>
                <hr>
                <div class="text-left">
                    <div class="row-sub mb-1" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;">Email</div>
                    <div class="mb-3"><span class="icon-envelope-o mr-2 text-muted"></span>@Model.Email</div>
                    <div class="row-sub mb-1" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;">Phone</div>
                    <div class="mb-3"><span class="icon-phone2 mr-2 text-muted"></span>@Model.Phone</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="hl-card">
            <div class="hl-card-head"><h2>Recent Listings</h2></div>
            <div class="table-responsive">
                <table class="table hl-table">
                    <thead><tr><th>Property</th><th>Price</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr>
                            <td><div class="d-flex align-items-center"><img src="../images/img_1.jpg" class="row-thumb mr-3"><div class="row-title">625 S. Berendo St</div></div></td>
                            <td>$2,265,500</td>
                            <td><span class="status-pill active">Available</span></td>
                        </tr>
                        <tr>
                            <td><div class="d-flex align-items-center"><img src="../images/img_2.jpg" class="row-thumb mr-3"><div class="row-title">871 Crenshaw Blvd, Apt 4B</div></div></td>
                            <td>$2,450/mo</td>
                            <td><span class="status-pill pending">Rented</span></td>
                        </tr>
                        <tr>
                            <td><div class="d-flex align-items-center"><img src="../images/img_3.jpg" class="row-thumb mr-3"><div class="row-title">853 S Lucerne Blvd</div></div></td>
                            <td>$980,000</td>
                            <td><span class="status-pill sold">Sold</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>