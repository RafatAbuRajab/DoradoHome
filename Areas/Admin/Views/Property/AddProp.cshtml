@model PropertyVM
@{
    ViewData["Title"] = "Add Property";
}
<div class="page-head">
    <div>
        <h1>Add Property</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Dashboard" asp-controller="Dashboard">Home</a><span class="sep">/</span><a asp-action="Property" asp-controller="Property">Properties</a><span class="sep">/</span><span class="current">Add New</span>
        </div>
    </div>
</div>


<form asp-action="AddProp" asp-controller="Property" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-lg-8">
            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Basic Information</h2></div>
                <div class="hl-card-body">
                    <div class="form-group">
                        <label asp-for="Name">Property Title</label>
                        <input asp-for="Name" type="text" class="form-control" placeholder="e.g. Modern Family House with Garden">
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="PropertyType">Property Type</label>
                            <select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<PropertyType>()" class="form-control"></select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="OfferType">Offer Type</label>
                            <select asp-for="OfferType" asp-items="Html.GetEnumSelectList<OfferType>()" class="form-control"></select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the property..."></textarea>
                    </div>
                </div>
            </div>

            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Location</h2></div>
                <div class="hl-card-body">
                    <div class="form-group">
                        <label asp-for="Address">Address</label>
                        <input asp-for="Address" type="text" class="form-control" placeholder="Jordan Street">
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group"><label asp-for="City">City</label><input asp-for="City" type="text" class="form-control" placeholder="Amman"></div>
                        <div class="col-md-4 form-group"><label asp-for="State">State</label><input asp-for="State" type="text" class="form-control" placeholder="Jordan"></div>
                        <div class="col-md-4 form-group"><label asp-for="ZipCode">ZIP Code</label><input asp-for="ZipCode" type="text" class="form-control" placeholder="11234"></div>
                    </div>
                </div>
            </div>

            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Details &amp; Specs</h2></div>
                <div class="hl-card-body">
                    <div class="row">
                        <div class="col-md-3 col-6 form-group"><label asp-for="BedRooms">Bedrooms</label><input asp-for="BedRooms" type="number" class="form-control"></div>
                        <div class="col-md-3 col-6 form-group"><label asp-for="BathRooms">Bathrooms</label><input asp-for="BathRooms" type="number" class="form-control"></div>
                        <div class="col-md-3 col-6 form-group"><label asp-for="Area">Area (sq ft)</label><input asp-for="Area" type="number" class="form-control"></div>
                        <div class="col-md-3 col-6 form-group"><label asp-for="YearBuilt">Year Built</label><input asp-for="YearBuilt" type="number" class="form-control"></div>
                    </div>
                    <div class="form-group mb-0">
                        <label asp-for="PropertyAmenities">Amenities</label>
                        <div class="row">
                            @foreach (var item in Model.PropertyAmenities)
                            {
                                <div class="col-md-3 col-6">
                                    <div class="custom-control custom-checkbox mb-2">
                                        <input name="SelectedAmenities" value="@item.Value" type="checkbox" class="custom-control-input" id="am_@item.Value">
                                        <label class="custom-control-label" for="am_@item.Value">@item.Text</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Photos</h2></div>
                <div class="hl-card-body">
                    <div class="upload-drop mb-3">
                        <span class="icon-cloud-upload"></span>
                        <input asp-for="Img" type="file" multiple class="form-control" id="imageInput" accept="image/*" hidden>
                        <label asp-for="Img" class="input-group-text btn btn-secondary" for="imageInput">Upload Photo</label>
                        <div class="form-hint">PNG, JPG up to 10MB each &mdash; first image will be used as the cover photo</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Publish</h2></div>
                <div class="hl-card-body">
                    <div class="form-group">
                        <label asp-for="Status">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PropertyStatus>()" class="form-control"></select>
                    </div>
                    <hr>
                    <button type="submit" class="btn btn-hl-primary btn-block mb-2">Save Property</button>
                </div>
            </div>

            <div class="hl-card mb-4">
                <div class="hl-card-head"><h2>Price</h2></div>
                <div class="hl-card-body">
                    <div class="form-group">
                        <label asp-for="Price">Price (USD)</label>
                        <input asp-for="Price" class="form-control" placeholder="$2,500,000">
                    </div>
                </div>
            </div>

            <div class="hl-card">
                <div class="hl-card-head"><h2>Assigned Agent</h2></div>
                <div class="hl-card-body">
                    <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-control"></select>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    const imageInput = document.getElementById("imageInput");
    const previewImage = document.getElementById("previewImage");

    imageInput.addEventListener("change", function () {

        if (this.files.length > 0) {

            previewImage.src = URL.createObjectURL(this.files[0]);

        }

    });
</script>   