@model ChangePasswordAgentVM
@inject UserManager<AppUser> userManager
@inject AppDbContext db
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var cuser = await userManager.GetUserAsync(User);
    var user = await userManager.FindByEmailAsync(cuser.Email);
    var role = await userManager.GetRolesAsync(user);
    var employee = db.Employees.Where(x => x.UserId == user.Id).FirstOrDefault();
}
<div class="page-head">
    <div>
        <h1>Settings</h1>
        <div class="breadcrumb-plain">
            <a asp-action="Dashboard" asp-controller="Dashboard">Home</a><span class="sep">/</span><span class="current">Settings</span>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-lg-3 mb-4">
        <div class="hl-card">
            <div class="hl-card-body text-center">
                <img src="@employee.Img" class="avatar-md mb-3" style="width:84px;height:84px;">
                <h5 class="font-weight-bold mb-0">@user.FullName</h5>
                <div class="row-sub mb-3">@role.FirstOrDefault()</div>
            </div>
            <div class="list-group list-group-flush">
                <a asp-action="Setting" asp-controller="Settings" asp-route-Userid="@user.Id" class="list-group-item list-group-item-action @(currentAction == "Setting" ? "active" : "") border-0 font-weight-bold" style="border-radius:0;"><span class="icon-user mr-2"></span>Profile</a>
                <a asp-action="Security" asp-controller="Settings" class="list-group-item list-group-item-action @(currentAction == "Security" ? "active" : "") border-0 font-weight-bold" style="border-radius:0;"><span class="icon-lock2 mr-2"></span>Security</a>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="tab-content">
            <form asp-action="Security" asp-controller="Settings">
                <input name="id" value="@user.Id" type="hidden" />
                <div class="tab-pane fade show active" id="tab-security">
                    <div class="hl-card mb-4">
                        <div class="hl-card-head"><h2>Change Password</h2></div>
                        <div class="hl-card-body">
                            <div asp-validation-summary="All"></div>
                            <div class="form-group"><label asp-for="CurrentPassword">Current Password</label><input asp-for="CurrentPassword" type="password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;"></div>
                            <div class="row">
                                <div class="col-md-6 form-group"><label asp-for="NewPassword">New Password</label><input asp-for="NewPassword" type="password" class="form-control"></div>
                                <div class="col-md-6 form-group mb-0"><label asp-for="ConfirmPassword">Confirm New Password</label><input asp-for="ConfirmPassword" type="password" class="form-control"></div>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-hl-primary">Update Security Settings</button>
                </div>
            </form>
        </div>
    </div>
</div>