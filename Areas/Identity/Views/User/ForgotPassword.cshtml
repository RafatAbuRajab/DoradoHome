@model ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="auth-form-side">
    <div class="auth-box">
        <h2 class="font-weight-bold mb-1">Forgot your password?</h2>
        <p class="row-sub mb-4">No problem &mdash; enter your email and we'll send you a verification code.</p>
        <div asp-validation-summary="All"></div>
        <form asp-action="ForgotPassword" asp-controller="User">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="you@doradohome.com" autofocus>
                <input asp-for="VerifyCode" type="hidden" value="0" />
            </div>
            <button type="submit" class="btn btn-hl-primary btn-block">Send Verification Code</button>
        </form>

        <p class="text-center mt-4 row-sub mb-0"><a asp-action="Login" asp-controller="User" style="font-weight:700;"><span class="icon-arrow-left mr-1"></span>Back to Log In</a></p>
    </div>
</div>