@model ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
}
<div class="auth-form-side">
    <div class="auth-box">
        <h2 class="font-weight-bold mb-1">Set a new password</h2>
        <p class="row-sub mb-4">Choose a strong password you haven't used before.</p>

        <form asp-action="ResetPassword" asp-controller="User" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Password">New Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" autofocus>
                <div class="form-hint">At least 8 characters, with a mix of letters, numbers, and symbols.</div>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;">
            </div>
            <button type="submit" class="btn btn-hl-primary btn-block">Reset Password</button>
        </form>
    </div>
</div>